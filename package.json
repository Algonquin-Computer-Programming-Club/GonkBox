{
  "name": "gonkbox",
  "version": "0.1.0",
  "private": true,
  "homepage": "/gonkbox",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "gonkbox-emu": "file:gonkbox-emu/pkg",
    "marked": "^18.0.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build:web": "react-scripts build",
    "build:wasm": "cd gonkbox-emu && wasm-pack build --target web --out-dir pkg",
    "build:wasm-dev": "cd gonkbox-emu && wasm-pack build --dev --target web --out-dir pkg",
    "build": "npm run build:wasm && npm run build:web",
    "start": "react-scripts start",
    "start-dev": "npm run build:wasm-dev && npm run start",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
